# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WORKERS_HEALTH_PORT=4100
LOG_LEVEL=info

# Infrastructure stack selector for the composition root:
#   memory → in-memory adapters (default; no Docker needed; used by all tests)
#   mongo  → MongoDB repos + Redis + RabbitMQ + live Razorpay gateway
# See infra/README.md. Bring the backing services up with `docker compose up -d`.
PERSISTENCE=memory

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Change streams (leaderboard hot-cache, live-busy meter) require a replica set,
# so the docker-compose Mongo is a single-node RS. Append the replicaSet param
# when PERSISTENCE=mongo: mongodb://localhost:27017/?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gymkartel

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_PREFETCH=10

# ─── Razorpay (UPI) ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=change-me-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

# ─── Brevo (SMS/email/WhatsApp) ─────────────────────────────────────────────
BREVO_API_KEY=change-me-brevo-key
BREVO_SMS_SENDER=GymKrtl

# ─── Expo push ──────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── S3 / Cloudflare R2 (object storage) ────────────────────────────────────
# Production: leave S3_ENDPOINT empty — the adapter derives the Cloudflare R2
# endpoint from R2_ACCOUNT_ID. Local: point at MinIO from docker-compose and use
# path-style addressing. MinIO root creds default to gymkartel / the value below;
# buckets gymkartel-share-cards, gymkartel-coach-docs, gymkartel-transformations
# are created by the compose `minio-setup` one-shot.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=gymkartel-assets
R2_PUBLIC_BASE_URL=https://assets.gymkartel.example
# Local MinIO (docker-compose): uncomment to route object storage locally.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# R2_ACCESS_KEY_ID=gymkartel
# R2_SECRET_ACCESS_KEY=gymkartel-local-secret
# R2_BUCKET=gymkartel-share-cards
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gymkartel-api

# ─── App version gate ───────────────────────────────────────────────────────
APP_LATEST_VERSION=1.4.0
APP_MIN_SUPPORTED_VERSION=1.2.0
