                "query": "mutation SyncCheckIn($input: SyncCheckInInput!) {\n  syncCheckIn(input: $input) {\n    checkIn {\n      id\n      gymTier\n      passTier\n      scannedAt\n      dayNumber\n      topUpAmountPaise\n      gym {\n        id\n        name\n      }\n    }\n    topUpRequired {\n      gymTier\n      amountPaise\n      razorpayOrderId\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"gymCheckInCode\": \"GYM-DELHI-001\",\n    \"scannedAt\": \"2026-07-15T09:30:00.000Z\",\n    \"idempotencyKey\": \"checkin-2026-07-15-0001\",\n    \"acceptedTopUp\": false\n  }\n}"
