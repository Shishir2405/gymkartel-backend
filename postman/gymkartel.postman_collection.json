{
  "info": {
    "_postman_id": "b3f6a1c2-9d4e-4f7a-8c21-gymkartel0001",
    "name": "Gym Kartel Backend",
    "description": "GraphQL Yoga API for Gym Kartel — an Indian multi-tier gym membership app (UPI payments via Razorpay).\n\nGraphQL endpoint: POST {{baseUrl}}/graphql\nRazorpay webhook: POST {{baseUrl}}/webhooks/razorpay\nHealth: GET {{baseUrl}}/health, GET {{baseUrl}}/ready\n\nAuth: obtain accessToken/refreshToken from Auth > verifyOtp (OTP login phone {{phone}}). The collection sends {{accessToken}} as a Bearer token by default. Import the 'Gym Kartel Local' environment first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "+919876543210",
      "type": "string"
    },
    {
      "key": "razorpaySignature",
      "value": "valid",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "requestOtp",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RequestOtp($input: RequestOtpInput!) {\n  requestOtp(input: $input)\n}",
                "variables": "{\n  \"input\": {\n    \"phone\": \"{{phone}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Request a one-time password for the given phone number. Returns Boolean!."
          },
          "response": []
        },
        {
          "name": "verifyOtp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the access and refresh tokens for authenticated requests.",
                  "let json;",
                  "try {",
                  "    json = pm.response.json();",
                  "} catch (e) {",
                  "    console.log('verifyOtp: response was not JSON');",
                  "    json = null;",
                  "}",
                  "",
                  "const tokens = json && json.data && json.data.verifyOtp;",
                  "",
                  "pm.test('verifyOtp returned tokens', function () {",
                  "    pm.expect(tokens, 'data.verifyOtp missing').to.be.an('object');",
                  "    pm.expect(tokens.accessToken, 'accessToken missing').to.be.a('string').and.not.empty;",
                  "    pm.expect(tokens.refreshToken, 'refreshToken missing').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (tokens && tokens.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', tokens.refreshToken);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('accessToken', tokens.accessToken);",
                  "        pm.environment.set('refreshToken', tokens.refreshToken);",
                  "    }",
                  "    console.log('Saved accessToken and refreshToken.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation VerifyOtp($input: VerifyOtpInput!) {\n  verifyOtp(input: $input) {\n    accessToken\n    refreshToken\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"phone\": \"{{phone}}\",\n    \"code\": \"123456\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Verify the OTP code and receive an AuthTokens { accessToken, refreshToken }. The test script stores both tokens into collection and environment variables."
          },
          "response": []
        },
        {
          "name": "refreshSession",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json;",
                  "try {",
                  "    json = pm.response.json();",
                  "} catch (e) {",
                  "    json = null;",
                  "}",
                  "const tokens = json && json.data && json.data.refreshSession;",
                  "if (tokens && tokens.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', tokens.refreshToken);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('accessToken', tokens.accessToken);",
                  "        pm.environment.set('refreshToken', tokens.refreshToken);",
                  "    }",
                  "    console.log('Refreshed and saved tokens.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RefreshSession($refreshToken: String!) {\n  refreshSession(refreshToken: $refreshToken) {\n    accessToken\n    refreshToken\n  }\n}",
                "variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Exchange a refresh token for a fresh AuthTokens pair. The test script updates the stored tokens."
          },
          "response": []
        }
      ]
    },
