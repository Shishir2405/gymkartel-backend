              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_Mq1234567890AB\",\n        \"order_id\": \"order_Mq0987654321CD\",\n        \"amount\": 49900,\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
