{
  "name": "@gymkartel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers": {
      "types": "./src/workers-api.ts",
      "import": "./src/workers-api.ts",
      "default": "./dist/workers-api.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "indexes": "tsx src/shared/db/apply-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@getbrevo/brevo": "^2.2.0",
    "@gymkartel/contracts": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^8.33.1",
    "amqplib": "^0.10.4",
    "effect": "^3.8.4",
    "expo-server-sdk": "^3.10.0",
    "graphql": "^16.9.0",
    "graphql-ws": "^5.16.0",
    "graphql-yoga": "^5.7.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "pino": "^9.4.0",
    "rate-limiter-flexible": "^5.0.3",
    "razorpay": "^2.9.4",
    "satori": "^0.28.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@gymkartel/eslint-config": "workspace:*",
    "@testcontainers/mongodb": "^10.28.0",
    "@types/amqplib": "^0.10.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/ws": "^8.5.12",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
